# =============================================================================
# DEEPSEARCH ENV VARS
# =============================================================================
# LOCAL DEV: copy to .env and fill in values
# RAILWAY:   set these in Railway Dashboard → Variables for the service
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Railway: Add Reference Variable → select your Postgres plugin → DATABASE_URL
# The value will look like: postgresql://user:password@host:5432/dbname
# Note: DATABASE_URL_SYNC is auto-derived by stripping "+asyncpg" from this.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/deepsearch

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-this-to-a-secure-64-char-random-string

# ── Research ──────────────────────────────────────────────────────────────────
# Get free key at https://tavily.com
TAVILY_API_KEY=tvly-...

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://deepsearch.up.railway.app
