{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheck": {
      "path": "/health/ready",
      "periodSeconds": 30,
      "timeoutSeconds": 10,
      "startupTimeoutSeconds": 60
    },
    "restartPolicy": {
      "type": "ON_FAILURE",
      "maxRetries": 3
    },
    "port": 8000
  }
}
